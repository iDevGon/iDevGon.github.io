{
  "name": "@idevgon/root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @idevgon/blog dev",
    "build": "pnpm --filter @idevgon/blog build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "fix": "pnpm check:fix"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.14"
    }
  }
}
